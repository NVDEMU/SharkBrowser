{
  "name": "shark-browser",
  "version": "0.1.0",
  "description": "A cross-platform Chromium browser with ad and tracker blocking",
  "main": "src/main.js",
  "author": "NVDEMU",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nvdemu.sharkbrowser",
    "productName": "Shark Browser",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.productivity" },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": ["AppImage", "deb"], "category": "Network;WebBrowser" }
  }
}