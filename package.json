{
  "name": "shark-browser",
  "version": "0.1.0",
  "description": "A cross-platform Chromium browser with ad and tracker blocking",
  "main": "src/main.js",
  "author": {
    "name": "NVDEMU",
    "email": "326190078+NVDEMU@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/guest-preload.js && node --check src/filtering.js && node --check src/renderer.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.nvdemu.sharkbrowser",
    "productName": "Shark Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;WebBrowser",
      "maintainer": "326190078+NVDEMU@users.noreply.github.com"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NVDEMU/SharkBrowser.git"
  },
  "homepage": "https://github.com/NVDEMU/SharkBrowser",
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "cross-fetch": "^4.1.0"
  },
  "desktopName": "com.nvdemu.sharkbrowser"
}
